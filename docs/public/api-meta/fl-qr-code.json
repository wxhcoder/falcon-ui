{
  "component": "fl-qr-code",
  "description": "二维码组件，用来把字符串生成二维码，支持颜色、尺寸和中间图标。",
  "events": [],
  "exposes": [],
  "props": [
    {
      "default": "'#ffffff'",
      "description": "设置背景颜色。",
      "name": "backgroundColor",
      "required": false,
      "type": "string | undefined"
    },
    {
      "default": "'#000000'",
      "description": "设置二维码深色块颜色。",
      "name": "color",
      "required": false,
      "type": "string | undefined"
    },
    {
      "default": "'M'",
      "description": "设置二维码容错等级，等级越高越不怕遮挡但图形越密。",
      "name": "errorCorrectionLevel",
      "required": false,
      "type": "\"M\" | \"L\" | \"Q\" | \"H\" | undefined"
    },
    {
      "default": "'#ffffff'",
      "description": "设置中间图标底板背景色。",
      "name": "iconBackgroundColor",
      "required": false,
      "type": "string | undefined"
    },
    {
      "default": "4",
      "description": "设置中间图标底板圆角，单位是像素。",
      "name": "iconBorderRadius",
      "required": false,
      "type": "number | undefined"
    },
    {
      "default": "24",
      "description": "设置中间图标尺寸，单位是像素。",
      "name": "iconSize",
      "required": false,
      "type": "number | undefined"
    },
    {
      "default": "''",
      "description": "设置中间图标地址。",
      "name": "iconSrc",
      "required": false,
      "type": "string | undefined"
    },
    {
      "default": "12",
      "description": "设置二维码内容和外边缘之间的留白，单位是像素。",
      "name": "padding",
      "required": false,
      "type": "number | undefined"
    },
    {
      "default": "100",
      "description": "设置二维码整体显示尺寸，单位是像素。",
      "name": "size",
      "required": false,
      "type": "number | undefined"
    },
    {
      "default": "'canvas'",
      "description": "设置二维码渲染方式，支持画布和矢量图。",
      "name": "type",
      "required": false,
      "type": "\"canvas\" | \"svg\" | undefined"
    },
    {
      "default": "''",
      "description": "设置要写进二维码里的内容。",
      "name": "value",
      "required": false,
      "type": "string | undefined"
    }
  ],
  "slots": []
}
