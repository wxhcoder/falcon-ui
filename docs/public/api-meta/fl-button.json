{
  "component": "fl-button",
  "description": "按钮组件，用来触发页面操作，支持加载、禁用、图标和调试点击。",
  "events": [
    {
      "description": "点击按钮时触发。",
      "name": "click",
      "signature": "(event: \"click\", evt: MouseEvent): void",
      "type": "[evt: MouseEvent]"
    },
    {
      "description": "开启调试模式后，按钮点击时额外触发。",
      "name": "debug-click",
      "signature": "(event: \"debug-click\", payload: FlButtonDebugPayload): void",
      "type": "[payload: FlButtonDebugPayload]"
    }
  ],
  "exposes": [
    {
      "description": "标记这个暴露值来自按钮组件，方便排查问题。",
      "name": "debugKind",
      "type": "string"
    },
    {
      "description": "返回当前按钮文字是否需要自动加空格。",
      "name": "shouldAddSpace",
      "type": "boolean"
    }
  ],
  "props": [
    {
      "default": "-",
      "description": "是否在页面加载后自动获得焦点。",
      "name": "autofocus",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "-",
      "description": "是否自动在两个中文字符之间加空格。",
      "name": "autoInsertSpace",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "-",
      "description": "文字按钮是否带背景色。",
      "name": "bg",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "-",
      "description": "是否显示成圆形按钮。",
      "name": "circle",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "-",
      "description": "设置主要颜色。",
      "name": "color",
      "required": false,
      "type": "string | undefined"
    },
    {
      "default": "-",
      "description": "是否使用深色背景下的按钮样式。",
      "name": "dark",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "-",
      "description": "是否显示虚线边框。",
      "name": "dashed",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "''",
      "description": "调试事件标签，开启调试模式后会一起抛出。",
      "name": "debugLabel",
      "required": false,
      "type": "string | undefined"
    },
    {
      "default": "false",
      "description": "是否开启调试点击事件，开启后每次点击都会额外通知外部。",
      "name": "debugMode",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "-",
      "description": "是否禁用组件。",
      "name": "disabled",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "-",
      "description": "设置图标。",
      "name": "icon",
      "required": false,
      "type": "IconPropType | undefined"
    },
    {
      "default": "-",
      "description": "是否显示成链接按钮样式。",
      "name": "link",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "-",
      "description": "是否显示加载中状态。",
      "name": "loading",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "-",
      "description": "设置加载中图标。",
      "name": "loadingIcon",
      "required": false,
      "type": "IconPropType | undefined"
    },
    {
      "default": "-",
      "description": "设置原生按钮提交类型。",
      "name": "nativeType",
      "required": false,
      "type": "\"button\" | \"submit\" | \"reset\" | undefined"
    },
    {
      "default": "-",
      "description": "是否使用朴素按钮样式。",
      "name": "plain",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "-",
      "description": "是否显示成圆角按钮。",
      "name": "round",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "-",
      "description": "设置组件尺寸。",
      "name": "size",
      "required": false,
      "type": "\"\" | \"default\" | \"small\" | \"large\" | undefined"
    },
    {
      "default": "-",
      "description": "设置按钮渲染成哪个标签。",
      "name": "tag",
      "required": false,
      "type": "string | Component | undefined"
    },
    {
      "default": "-",
      "description": "是否显示成文字按钮。",
      "name": "text",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "-",
      "description": "设置按钮的视觉类型。",
      "name": "type",
      "required": false,
      "type": "\"\" | \"text\" | \"default\" | \"primary\" | \"success\" | \"warning\" | \"info\" | \"danger\" | undefined"
    }
  ],
  "slots": [
    {
      "description": "自定义按钮文字或内容。",
      "name": "default",
      "type": "{}"
    },
    {
      "description": "自定义按钮左侧图标。",
      "name": "icon",
      "type": "{}"
    },
    {
      "description": "自定义加载中图标。",
      "name": "loading",
      "type": "{}"
    }
  ]
}
