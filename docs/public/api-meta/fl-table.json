{
  "component": "fl-table",
  "description": "表格组件，用来展示列表数据，并支持选择增强、单元格变更监听、行拖拽和列拖拽。",
  "events": [
    {
      "description": "检测到单元格字段被改写时触发。",
      "name": "cell-change",
      "signature": "(event: \"cell-change\", payload: CellChangeEvent): void",
      "type": "[payload: CellChangeEvent]"
    },
    {
      "description": "结束拖拽列时触发。",
      "name": "column-drag-end",
      "signature": "(event: \"column-drag-end\", payload: ColumnDragEvent): void",
      "type": "[payload: ColumnDragEvent]"
    },
    {
      "description": "开始拖拽列时触发。",
      "name": "column-drag-start",
      "signature": "(event: \"column-drag-start\", payload: ColumnDragEvent): void",
      "type": "[payload: ColumnDragEvent]"
    },
    {
      "description": "列顺序发生变化时触发。",
      "name": "column-order-change",
      "signature": "(event: \"column-order-change\", payload: ColumnOrderChangeEvent): void",
      "type": "[payload: ColumnOrderChangeEvent]"
    },
    {
      "description": "结束拖拽行时触发。",
      "name": "row-drag-end",
      "signature": "(event: \"row-drag-end\", payload: RowDragEvent): void",
      "type": "[payload: RowDragEvent]"
    },
    {
      "description": "开始拖拽行时触发。",
      "name": "row-drag-start",
      "signature": "(event: \"row-drag-start\", payload: RowDragEvent): void",
      "type": "[payload: RowDragEvent]"
    },
    {
      "description": "行顺序发生变化时触发。",
      "name": "row-order-change",
      "signature": "(event: \"row-order-change\", payload: RowOrderChangeEvent): void",
      "type": "[payload: RowOrderChangeEvent]"
    },
    {
      "description": "点击行或选择变化导致选中状态切换时触发。",
      "name": "selection-row-toggle",
      "signature": "(event: \"selection-row-toggle\", payload: SelectionRowToggleEvent): void",
      "type": "[payload: SelectionRowToggleEvent]"
    },
    {
      "description": "单选约束与原生多选行为冲突时触发。",
      "name": "selection-single-conflict",
      "signature": "(event: \"selection-single-conflict\", payload: SelectionSingleConflictEvent): void",
      "type": "[payload: SelectionSingleConflictEvent]"
    }
  ],
  "exposes": [
    {
      "description": "清空表格筛选条件。",
      "name": "clearFilter",
      "type": "(columnKeys?: string | string[] | undefined) => void"
    },
    {
      "description": "清空表格当前选中的行。",
      "name": "clearSelection",
      "type": "() => void"
    },
    {
      "description": "清空表格排序状态。",
      "name": "clearSort",
      "type": "() => void"
    },
    {
      "description": "让表格重新计算列宽和布局。",
      "name": "doLayout",
      "type": "() => void"
    },
    {
      "description": "获取表格当前选中的行数据。",
      "name": "getSelectionRows",
      "type": "() => RowData[]"
    },
    {
      "description": "滚动到指定位置或指定节点。",
      "name": "scrollTo",
      "type": "{ (options: ScrollToOptions): void; (xCoord: number, yCoord?: number | undefined): void; }"
    },
    {
      "description": "设置表格当前高亮行。",
      "name": "setCurrentRow",
      "type": "(row?: RowData | undefined) => void"
    },
    {
      "description": "设置表格横向滚动位置。",
      "name": "setScrollLeft",
      "type": "(left: number) => void"
    },
    {
      "description": "设置表格纵向滚动位置。",
      "name": "setScrollTop",
      "type": "(top: number) => void"
    },
    {
      "description": "按指定列触发表格排序。",
      "name": "sort",
      "type": "(prop: string, order: \"ascending\" | \"descending\" | null) => void"
    },
    {
      "description": "切换表格全选状态。",
      "name": "toggleAllSelection",
      "type": "() => void"
    },
    {
      "description": "切换指定行的展开状态。",
      "name": "toggleRowExpansion",
      "type": "(row: RowData, expanded?: boolean | undefined) => void"
    },
    {
      "description": "切换指定行的选中状态。",
      "name": "toggleRowSelection",
      "type": "(row: RowData, selected?: boolean | undefined, ignoreSelectable?: boolean | undefined) => void"
    }
  ],
  "props": [
    {
      "default": "4",
      "description": "单元格数据写入监听的最大层级。",
      "name": "cellProxyMaxDepth",
      "required": false,
      "type": "number | undefined"
    },
    {
      "default": "true",
      "description": "是否开启列拖拽。",
      "name": "columnDraggable",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "false",
      "description": "点击单元格时，是否高亮同一行和同一列。",
      "name": "crossHighlight",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "[]",
      "description": "表格数据源。",
      "name": "data",
      "required": false,
      "type": "RowData[] | undefined"
    },
    {
      "default": "true",
      "description": "是否开启可编辑单元格模式。",
      "name": "isEdit",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "true",
      "description": "是否开启行拖拽。",
      "name": "rowDraggable",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "0",
      "description": "行拖拽控制柄所在列索引。",
      "name": "rowDragHandleColumnIndex",
      "required": false,
      "type": "number | undefined"
    },
    {
      "default": "'id'",
      "description": "事件回调中用于标识行主键的字段名。",
      "name": "rowKeyField",
      "required": false,
      "type": "string | undefined"
    },
    {
      "default": "true",
      "description": "存在选择列时，是否支持点击行联动选中。",
      "name": "selectionRowClick",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "false",
      "description": "多选模式下是否限制为仅能选中一行。",
      "name": "selectionSingle",
      "required": false,
      "type": "boolean | undefined"
    }
  ],
  "slots": []
}
