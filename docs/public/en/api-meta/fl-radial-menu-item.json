{
  "component": "fl-radial-menu-item",
  "description": "Radial menu item component used inside the radial menu to declare one action.",
  "events": [],
  "exposes": [],
  "props": [
    {
      "default": "undefined",
      "description": "Whether selecting this item closes the whole menu.",
      "name": "closeOnSelect",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "false",
      "description": "Whether the component is disabled.",
      "name": "disabled",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "false",
      "description": "Whether to show a separator in the overflow menu.",
      "name": "divided",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "false",
      "description": "Whether this menu item is hidden.",
      "name": "hidden",
      "required": false,
      "type": "boolean | undefined"
    },
    {
      "default": "undefined",
      "description": "Icon.",
      "name": "icon",
      "required": false,
      "type": "Component | undefined"
    },
    {
      "default": "-",
